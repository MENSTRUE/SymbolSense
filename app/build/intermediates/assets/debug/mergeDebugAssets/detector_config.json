{
  "version": "crohme_detector_v2",
  "dataset": "CROHME2019",
  "input_width": 384,
  "input_height": 256,
  "channels": 1,
  "stride": 4,
  "grid_width": 96,
  "grid_height": 64,
  "confidence_threshold": 0.35,
  "nms_iou": 0.35,
  "max_detections": 128,
  "recommended_variant": "fp16",
  "ground_truth_contract": "one bbox = one symbol traceGroup from the same InkML sample",
  "training_augmentation": [
    "perspective",
    "affine",
    "lighting",
    "screen_moire",
    "blur",
    "sensor_noise",
    "jpeg",
    "light_on_dark",
    "hard_negative"
  ]
}